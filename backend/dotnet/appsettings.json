{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NodeServices": {
    "BaseUrl": "http://localhost:5000"
  },
  "Auth": {
    "RequireEmailVerification": false
  },
  "Jwt": {
    "Issuer": "LegalConnect-API",
    "Audience": "LegalConnect-Admin"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:4201",
      "http://localhost:4300",
      "https://legalconnect-501109.web.app",
      "https://legalconnect-501109.firebaseapp.com",
      "https://legalconnect-admin.web.app",
      "https://legalconnect-admin.firebaseapp.com",
      "https://admin.legalconnect-501109.web.app"
    ]
  },
  "AppUrl": "http://localhost:4200",
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 30,
      "WindowMinutes": 1
    },
    "AuthSession": {
      "PermitLimit": 120,
      "WindowMinutes": 1
    },
    "AdminModeration": {
      "PermitLimit": 50,
      "WindowMinutes": 1
    }
  },
  "Kestrel": {
    "Limits": {
      "MinRequestBodyDataRate": null,
      "MinResponseDataRate": null,
      "KeepAliveTimeout": "00:05:00",
      "RequestHeadersTimeout": "00:01:00"
    }
  }
}