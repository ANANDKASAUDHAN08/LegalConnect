{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/media/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "legal-api",
      "urls": [
        "/api/legal/**",
        "/api/lawyers/**"
      ],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "7d",
        "timeout": "5s",
        "strategy": "performance"
      }
    },
    {
      "name": "announcements-api",
      "urls": [
        "/api/announcements/**"
      ],
      "cacheConfig": {
        "maxSize": 20,
        "maxAge": "12h",
        "timeout": "5s",
        "strategy": "freshness"
      }
    }
  ]
}